<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F7F2</item>
        <item name="android:statusBarColor">#F7F7F2</item>
        <item name="android:colorAccent">#006C67</item>
    </style>
    <style name="StopConfirmationDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowGravity">center</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/StopConfirmationPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/StopConfirmationCancelButton</item>
    </style>
    <style name="StopConfirmationPositiveButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/stop_confirmation_positive</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/stop_confirmation_text</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
    <style name="StopConfirmationCancelButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/stop_confirmation_cancel</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#202124</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
