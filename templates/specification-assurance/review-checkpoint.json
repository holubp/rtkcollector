  "scope_digest": "sha256:<checker-produced scope digest>",
  "base_commit": "<trusted comparison base or null>",
  "context_file": ".spec-assurance/review-context.json",
  "context_command": "<exact checker command used to regenerate context>",
  "trusted_base_controls": false,
  "handoff_to": "<initializer | updater | checker | human | none>",
  "reviewed_paths": ["path/to/reviewed-file"],
