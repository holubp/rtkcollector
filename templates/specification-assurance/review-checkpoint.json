      "path": "path/to/reviewed-file",
      "requirement_id": "CORE-FLOW-001",
      "summary": "Concrete progress finding."
    }
  ],
  "limitations": ["Known review limitation or empty list."],
  "next_action": "Regenerate context after the human decision.",
  "reviewer": "model:reviewer-id",
  "created_at": "<timezone-aware timestamp>",
  "updated_at": "<timezone-aware timestamp>",
  "resumed_at": "<timezone-aware timestamp or null>"
}
